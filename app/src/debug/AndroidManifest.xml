<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application>
        <provider
            android:name="com.mica.music.data.TestDocumentsProvider"
            android:authorities="${applicationId}.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- PROTOTYPE: debug-only, ADB-driven SK02 descriptor/USBFS probe. -->
        <receiver
            android:name=".media.usbprototype.UsbSk02DescriptorPrototypeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.debug.USB_SK02_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_CLAIM_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_NATIVE_FD_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_RECONNECT" />
                <action android:name="${applicationId}.debug.USB_SK02_FORCE_CLAIM_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_ISO_FEEDBACK_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_SILENT_PCM16_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_SUSTAINED_PCM16_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_GENERATION_PCM16_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_BUFFERED_PCM16_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA_FORMAT_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA_DECODE_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA_USB_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_HIGH_RES_DECODE_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_FFMPEG24_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_FFMPEG24_USB_PROBE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_ENABLE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_DISABLE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_PLAY" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_PAUSE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_NEXT" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_SELECT_INDEX" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_SEEK_NEAR_END" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_REPEAT_ONE" />
                <action android:name="${applicationId}.debug.USB_SK02_MEDIA3_REPEAT_OFF" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.mica.music.media.HybridQaPlaybackReceiver"
            android:exported="true" />

        <!-- Debug-only, explicit-broadcast S4 SAF shadow gate control seam. -->
        <receiver
            android:name="com.mica.music.data.LibraryAutoSyncQaReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.debug.LIBRARY_S4_RUN_SCENARIO" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_PROFILE_METADATA" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_EXTERNAL_PROVIDER_PROBE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_EXTERNAL_PROVIDER_PREPARE_FIXTURE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_EXTERNAL_PROVIDER_PAYLOAD_GATE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_EXTERNAL_PROVIDER_PAYLOAD_PLAYBACK_GATE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_PREPARE_PLAYBACK_BASELINE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_PLAYBACK_DEFER_GATE" />
                <action android:name="${applicationId}.debug.LIBRARY_S4_DUMP_PROFILE_EVIDENCE" />
            </intent-filter>
        </receiver>

        <!-- Debug-only user-selected SAF tree picker / vendor provider gate. -->
        <activity
            android:name="com.mica.music.data.LibraryAutoSyncQaPickerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!--
            Debug-only one-shot picker automation seam. It is never enabled by production code:
            the device Gate temporarily enables it through secure settings, it only clicks the
            DocumentsUI confirm button when MicaSafVendorGate is visible, then disableSelf().
        -->
        <service
            android:name="com.mica.music.data.LibraryAutoSyncQaPickerClickService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/library_auto_sync_qa_picker_accessibility" />
        </service>

        <!-- Debug-only long-running S4 metadata profiler. -->
        <service
            android:name="com.mica.music.data.LibraryAutoSyncQaProfileService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
